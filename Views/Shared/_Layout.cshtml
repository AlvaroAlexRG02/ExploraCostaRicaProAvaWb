<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Explora Costa Rica
    </title>


    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         CSS GENERAL DEL PROYECTO
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <link rel="stylesheet"
          href="~/ExploraCostaRica.styles.css"
          asp-append-version="true" />


    <style>

        /* ====================================================
                   BARRA DE NAVEGACIÓN GENERAL
                   ==================================================== */

        header {
            position: sticky;
            top: 0;
            z-index: 1050;
            padding: 10px 18px 0;
            background: rgba(255, 255, 255, .94);
            backdrop-filter: blur(10px);
        }


        .main-navbar {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 8px 18px;
            background: rgba(255, 255, 255, .98);
            border: 1px solid rgba(15, 85, 60, .08);
            border-radius: 26px;
            box-shadow: 0 7px 25px rgba(14, 57, 43, .10);
        }


        /* ====================================================
                   LOGO
                   ==================================================== */

        .explora-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #123c2e !important;
            font-size: 1.35rem;
            font-weight: 800;
            text-decoration: none;
            white-space: nowrap;
        }


        .brand-icon {
            width: 39px;
            height: 39px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: linear-gradient( 135deg, #08795b, #31a678 );
            color: white;
            font-size: 1.15rem;
            box-shadow: 0 5px 13px rgba(8, 121, 91, .22);
        }


        /* ====================================================
                   OPCIONES CENTRALES
                   ==================================================== */

        .main-navbar .navbar-nav {
            align-items: center;
            gap: 4px;
        }


        .main-navbar .nav-link {
            position: relative;
            color: #24372f !important;
            font-size: .91rem;
            font-weight: 600;
            margin: 0 2px;
            padding: 9px 13px !important;
            border-radius: 999px;
            transition: color .2s ease, background .2s ease;
        }


            .main-navbar .nav-link:hover {
                background: #e9f6f0;
                color: #08795b !important;
            }


            .main-navbar .nav-link::after {
                content: "";
                position: absolute;
                left: 50%;
                bottom: 2px;
                width: 0;
                height: 2px;
                border-radius: 10px;
                background: #08795b;
                transform: translateX(-50%);
                transition: width .2s ease;
            }


            .main-navbar .nav-link:hover::after {
                width: 50%;
            }


        /* ====================================================
                   ZONA DERECHA
                   ==================================================== */

        .main-navbar .d-flex.align-items-center.gap-3 {
            gap: 14px !important;
        }


        .main-navbar a[title="Buscar"],
        .main-navbar a[title="Favoritos"] {
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: #1f382e !important;
            font-size: 1.05rem;
            transition: .2s;
        }


            .main-navbar a[title="Buscar"]:hover,
            .main-navbar a[title="Favoritos"]:hover {
                background: #e9f6f0;
                color: #08795b !important;
            }


        /* ====================================================
                   BOTÓN INICIAR SESIÓN
                   ==================================================== */

        .login-button {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 19px !important;
            background: #08795b;
            color: white !important;
            border-radius: 999px;
            text-decoration: none;
            font-size: .9rem;
            font-weight: 700;
            box-shadow: 0 5px 14px rgba(8, 121, 91, .20);
            transition: background .2s ease, transform .2s ease;
        }


            .login-button:hover {
                background: #056047;
                color: white !important;
                transform: translateY(-1px);
            }


        /* ====================================================
                   BOTÓN RESPONSIVE
                   ==================================================== */

        .navbar-toggler {
            border: none !important;
            box-shadow: none !important;
        }


        /* ====================================================
                   CONTENIDO PRINCIPAL
                   ==================================================== */

        .main-content {
            min-height: calc(100vh - 150px);
        }


        /* ====================================================
                   FOOTER
                   ==================================================== */

        .main-footer {
            margin-top: 50px;
            padding: 25px 0;
            border-top: 1px solid #e3ebe7;
            background: white;
            color: #6d7974;
        }


            .main-footer a {
                color: #08795b;
                text-decoration: none;
            }


                .main-footer a:hover {
                    text-decoration: underline;
                }


        /* ====================================================
                   RESPONSIVE
                   ==================================================== */

        @@media (max-width: 991px) {

            header {
                padding: 8px 8px 0;
            }


            .main-navbar {
                border-radius: 18px;
                padding: 8px 13px;
            }


            .navbar-collapse {
                margin-top: 12px;
                padding-top: 10px;
                border-top: 1px solid #edf1ef;
            }


            .main-navbar .navbar-nav {
                align-items: stretch;
            }


            .main-navbar .nav-link {
                margin-bottom: 3px;
            }


            .main-navbar .d-flex.align-items-center.gap-3 {
                margin-top: 10px;
                padding-bottom: 5px;
            }
        }

    </style>

</head>


<body>


    <!-- =====================================================
         MENÚ PRINCIPAL
         ===================================================== -->

    <header>

        <nav class="navbar navbar-expand-lg main-navbar">

            <div class="container">


                <!-- ==========================================
                     LOGO / NOMBRE
                     ========================================== -->

                <a class="explora-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">
                        🍃
                    </span>

                    <span>
                        Explora Costa Rica
                    </span>

                </a>


                <!-- ==========================================
                     BOTÓN RESPONSIVE
                     ========================================== -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Mostrar navegación">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- ==========================================
                     OPCIONES DEL MENÚ
                     ========================================== -->

                <div class="collapse navbar-collapse"
                     id="mainNavbar">


                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">


                        <!-- INICIO -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Inicio

                            </a>

                        </li>


                        <!-- EXPLORAR -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Explorar"
                               asp-action="Index">

                                Explorar

                            </a>

                        </li>


                        <!-- DESTINOS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Destinations"
                               asp-action="Index">

                                Destinos

                            </a>

                        </li>


                        <!-- FAVORITOS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Favoritos"
                               asp-action="Index">

                                Favoritos

                            </a>

                        </li>


                        <!-- DESCARGAS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Descargas"
                               asp-action="Index">

                                Descargas

                            </a>

                        </li>


                    </ul>


                    <!-- ======================================
                         BOTONES DERECHA
                         ====================================== -->

                    <div class="d-flex align-items-center gap-3">


                        <!-- BUSCADOR GLOBAL
                             Por ahora solo visual -->

                        <a href="#"
                           class="text-dark text-decoration-none"
                           title="Buscar">

                            🔍

                        </a>


                        <!-- FAVORITOS RÁPIDOS -->

                        <a asp-controller="Favoritos"
                           asp-action="Index"
                           class="text-dark text-decoration-none"
                           title="Favoritos">

                            ♡

                        </a>


                        <!-- LOGIN
                             Lo conectaremos después -->

                        <a href="#"
                           class="login-button">

                            👤 Iniciar sesión

                        </a>


                    </div>


                </div>

            </div>

        </nav>

    </header>


    <!-- =====================================================
         CONTENIDO DE CADA PÁGINA
         ===================================================== -->

    <main class="main-content container">

        @RenderBody()

    </main>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer class="main-footer">

        <div class="container">


            <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-between
                        align-items-center
                        gap-2">


                <div>

                    &copy; 2026 -
                    <strong>Explora Costa Rica</strong>

                </div>


                <div>

                    Descubre naturaleza, cultura y biodiversidad
                    en un solo lugar.

                </div>


            </div>

        </div>

    </footer>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
    "Scripts",
        required: false
        )


</body>

</html>