
@model ExploraCostaRica.Controllers.DescargasViewModel

@{
    ViewData["Title"] = "Descargas";
}

<style>
    .descargas-container {
        max-width: 1150px;
        margin: auto;
        padding: 30px 15px;
    }

    .descargas-hero {
        background: linear-gradient(120deg, #064e3b, #059669);
        color: white;
        text-align: center;
        padding: 45px 20px;
        border-radius: 18px;
        margin-bottom: 25px;
    }

    .descargas-hero h1 {
        font-size: 38px;
        font-weight: bold;
    }

    .estadisticas {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 30px;
    }

    .estadistica {
        background: #ecfdf5;
        border: 1px solid #d1fae5;
        padding: 20px;
        border-radius: 12px;
        text-align: center;
    }

    .estadistica h2 {
        color: #047857;
        font-size: 30px;
    }

    .titulo-seccion {
        color: #065f46;
        font-weight: bold;
        margin: 30px 0 18px;
    }

    .contenidos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    .contenido-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 12px #00000010;
    }

    .contenido-card img {
        width: 100%;
        height: 160px;
        object-fit: cover;
    }

    .contenido-info {
        padding: 18px;
    }

    .contenido-info h5 {
        color: #064e3b;
        font-weight: bold;
    }

    .contenido-info p {
        color: #64748b;
        font-size: 14px;
    }

    .btn-descargar {
        width: 100%;
        background: #047857;
        color: white;
        border: none;
        padding: 11px;
        border-radius: 8px;
    }

    .btn-descargar:hover {
        background: #065f46;
        color: white;
    }

    .historial-tabla {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

    .historial-tabla th {
        background: #064e3b;
        color: white;
        padding: 14px;
        text-align: left;
    }

    .historial-tabla td {
        padding: 12px;
        border-bottom: 1px solid #e5e7eb;
        vertical-align: middle;
    }

    .historial-container {
        overflow-x: auto;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
    }

    .acciones {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .acciones form {
        margin: 0;
    }

    .acciones .btn {
        font-size: 12px;
        white-space: nowrap;
    }

    .upload-section {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 14px;
        padding: 25px;
        margin-bottom: 30px;
    }

    @@media (max-width: 600px) {
        .estadisticas {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="descargas-container">

    <div class="descargas-hero">
        <h1>Descargas</h1>
        <p>Explorá, descargá y conservá información de Costa Rica.</p>
        <p>Archivos disponibles en formato JSON</p>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="estadisticas">
        <div class="estadistica">
            <h2>@Model.Historial.Count</h2>
            <span>Descargas realizadas</span>
        </div>

        <div class="estadistica">
            <h2>@Model.Contenidos.Count</h2>
            <span>Contenidos disponibles</span>
        </div>

        <div class="estadistica">
            <h2>JSON</h2>
            <span>Formato disponible</span>
        </div>
    </div>

    <!-- IMPORTACIÓN DE JSON -->
    <section class="upload-section">
        <h3 class="titulo-seccion mt-0">
            📤 Importar archivo JSON
        </h3>

        <p class="text-muted">
            Seleccioná un archivo JSON para importar
            su información a Explora Costa Rica.
        </p>

        <form asp-controller="Descargas"
              asp-action="SubirJson"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="archivo" class="form-label">
                    Seleccionar archivo JSON
                </label>

                <input type="file"
                       id="archivo"
                       name="archivo"
                       accept=".json,application/json"
                       class="form-control"
                       required />
            </div>

            <button type="submit" class="btn btn-success">
                📤 Subir JSON
            </button>
        </form>
    </section>

    <h3 class="titulo-seccion">Contenido disponible</h3>

    @if (!Model.UsuarioDemoId.HasValue)
    {
        <div class="alert alert-warning">
            No existe un usuario demo activo para descargar.
        </div>
    }

    @if (!Model.Contenidos.Any())
    {
        <div class="alert alert-info">
            No hay contenido disponible.
        </div>
    }

    <div class="contenidos-grid">
        @foreach (var item in Model.Contenidos)
        {
            <div class="contenido-card">

                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                {
                    <img src="@item.ImageUrl"
                         alt="@item.Title"
                         loading="lazy" />
                }

                <div class="contenido-info">
                    <h5>@item.Title</h5>

                    <p>
                        @(item.Description?.Length > 110
                            ? item.Description.Substring(0, 110) + "..."
                            : item.Description ?? "Información de Costa Rica")
                    </p>

                    <p>
                        <strong>Categoría:</strong>
                        @(item.Category?.Name ?? "General")
                    </p>

                    <p>
                        <strong>Destino:</strong>
                        @(item.Destination?.Name ?? "Costa Rica")
                    </p>

                    <form asp-controller="Descargas"
                          asp-action="DescargarJson"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="mediaId"
                               value="@item.MediaId" />

                        <button type="submit"
                                class="btn-descargar"
                                disabled="@(!Model.UsuarioDemoId.HasValue)">
                            ⬇ Descargar JSON
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <h3 class="titulo-seccion">Mi historial de descargas</h3>

    <div class="historial-container">
        <table class="historial-tabla">
            <thead>
                <tr>
                    <th>Contenido</th>
                    <th>Archivo</th>
                    <th>Formato</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var descarga in Model.Historial)
                {
                    <tr>
                        <td>@descarga.Media?.Title</td>

                        <td>@descarga.FileName</td>

                        <td>
                            <span class="badge bg-success">
                                @descarga.FileFormat
                            </span>
                        </td>

                        <td>
                            @descarga.DownloadedAt.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            <div class="acciones">

                                <a asp-controller="Descargas"
                                   asp-action="Abrir"
                                   asp-route-id="@descarga.DownloadId"
                                   target="_blank"
                                   rel="noopener"
                                   class="btn btn-outline-primary">
                                    👁 Abrir
                                </a>

                                <form asp-controller="Descargas"
                                      asp-action="DescargarJson"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="mediaId"
                                           value="@descarga.MediaId" />

                                    <button type="submit"
                                            class="btn btn-outline-success">
                                        ⬇ Descargar
                                    </button>
                                </form>

                                <form asp-controller="Descargas"
                                      asp-action="Eliminar"
                                      method="post"
                                      onsubmit="return confirm('¿Eliminar este registro del historial?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@descarga.DownloadId" />

                                    <button type="submit"
                                            class="btn btn-outline-danger">
                                        🗑 Eliminar
                                    </button>
                                </form>

                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Historial.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center p-4">
                            Todavía no hay descargas registradas.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
